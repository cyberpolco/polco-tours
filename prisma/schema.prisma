// POLCO TOURS — Prisma schema (Phase 0 foundation)
// Implements the Vol. 6 identity/tenancy/finance/system core plus a single
// tenant-scoped table (tour_packages) used to prove Row-Level Security.
// Full ERD grows here phase by phase; every structural change is recorded in
// docs/decisions (DR-007, living-document mandate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon -pooler) at runtime
  directUrl = env("DIRECT_URL") // direct connection for migrations
}

// ----------------------------------------------------------------- enums
enum Role {
  SUPERADMIN
  PLATFORM_ADMIN
  TOUR_OPERATOR
  TOUR_GUIDE
  DRIVER
  VEHICLE_OWNER
  VISA_FACILITATOR
  TOURIST
}

enum OrgStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum PackageStatus {
  DRAFT
  // DR-117: split from the single PUBLISHED value -- both remain visible to
  // guests (isPackageVisible), but only PUBLISHED_AVAILABLE is bookable
  // (isBookable) -- see catalog/domain.ts's isPublishedStatus.
  PUBLISHED_AVAILABLE
  PUBLISHED_UNAVAILABLE
  ARCHIVED
}

enum Currency {
  USD
  EUR
  NAD
  CDF
}

enum DepartureStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// v2 (replaces HELD/CONFIRMED/CANCELLED/EXPIRED/QUOTE_REQUESTED). A hold is
// now AWAITING_DEPOSIT + holdExpiresAt (was HELD); an expired hold lazily
// sweeps straight to CANCELLED -- there is no dedicated EXPIRED value here,
// so the expired-vs-manually-cancelled distinction survives only in the
// audit log. DRAFT exists for spec completeness; no current flow produces a
// row that stays there (both booking origins set a real starting status
// immediately on creation).
enum BookingStatus {
  DRAFT
  AWAITING_QUOTATION
  QUOTATION_SENT
  AWAITING_DEPOSIT
  DEPOSIT_PAID
  FULLY_PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BookingOrigin {
  PREDEFINED_PACKAGE
  TAILOR_MADE
}

// DR-207: the guest-facing Cancellation & Refund Policy tier, snapshotted
// onto Booking.cancellationRefundTier at the moment a guest cancels via
// /find-booking. FULL_MINUS_DEPOSIT/FIFTY_PERCENT/TWENTY_FIVE_PERCENT/NONE
// mirror the 60+/30-59/14-29/under-14-days-before-departure tiers; there is
// no operator-cancellation (force-majeure) value here since that path is
// staff-initiated, not this guest self-service one.
enum CancellationRefundTier {
  FULL_MINUS_DEPOSIT
  FIFTY_PERCENT
  TWENTY_FIVE_PERCENT
  NONE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum Locale {
  EN
  FR
}

// ICAO 9303 passport MRZ sex convention (matches what a passport encodes).
enum Sex {
  M
  F
  X
}

enum AddonCode {
  PHOTOGRAPHY
  VIDEOGRAPHY
  TRANSLATOR
  VISA_ASSISTANCE
  ESIM
  FLIGHT_TICKET
}

// DR-222: flight-ticket add-on class of service.
enum FlightClass {
  ECONOMY
  BUSINESS
  FIRST
}

// Powers the public "tailor your trip" quiz's interest-matching (DR-016).
// DR-253 (explicit user request, 3 of them chosen from a shortlist):
// CAMPING/ADRENALINE/BIRDWATCHING/HONEYMOON/SELF_DRIVE added -- also the
// same vocabulary GuideProfile.specialties draws from (DR-245).
enum PackageTag {
  WILDLIFE
  ADVENTURE
  RELAXATION
  FAMILY
  CULTURE
  LUXURY
  BUDGET
  CAMPING
  ADRENALINE
  BIRDWATCHING
  HONEYMOON
  SELF_DRIVE
}

// Fleet + compliance (DR-017, Phase 2 Increment 1).
enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DriverStatus {
  ACTIVE
  SUSPENDED
}

// Guides Module (DR-030) -- folded into the fleet module per explicit user
// choice, rather than a standalone module, to reuse its existing
// compliance-document/anti-BOLA plumbing directly.
enum GuideStatus {
  ACTIVE
  SUSPENDED
}

// DR-082: usage-recency status, a dimension deliberately independent of
// Vehicle/Driver/GuideStatus above -- MAINTENANCE/RETIRED/SUSPENDED are
// manual operational/compliance holds; this tracks whether a resource is
// currently on a confirmed trip (BOOKED), free (AVAILABLE), or hasn't had
// one in 2+ months (INACTIVE). A vehicle in MAINTENANCE can still be
// AVAILABLE or INACTIVE on this axis; the two are checked independently
// wherever they matter (assignment eligibility only ever looks at the
// ACTIVE/SUSPENDED/MAINTENANCE/RETIRED status, never this one).
enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  INACTIVE
}

// ------------------------------------------------------------- identity
model Organization {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  countries     String[] // ISO-3166 alpha-2, e.g. ["NA","CD"]
  status        OrgStatus @default(PENDING)
  isPrimary     Boolean   @default(false)
  // "The Tour Operator"'s own agency-wide score (DR-037), live-recomputed
  // from Review.overallRating on every submission -- written directly by
  // ratingsRepository, since no module otherwise owns Organization (same
  // "shared, no owning module" precedent as TaxRate pre-DR-034).
  averageRating Float?
  ratingCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  members               Membership[]
  packages              TourPackage[]
  departures            Departure[]
  bookings              Booking[]
  invoices              Invoice[]
  payments              Payment[]
  travelers             Traveler[]
  documents             Document[]
  addonServices         AddonService[]
  bookingAddons         BookingAddon[]
  packageAddonServices  PackageAddonService[]
  vehicles              Vehicle[]
  driverProfiles        DriverProfile[]
  guideProfiles         GuideProfile[]
  assignments           Assignment[]
  visaApplications      VisaApplication[]
  maintenanceRecords    MaintenanceRecord[]
  starlinkKits          StarlinkKit[]
  itineraries           Itinerary[]
  itineraryDays         ItineraryDay[]
  itineraryDaySites     ItineraryDaySite[]
  hotels                Hotel[]
  restaurants           Restaurant[]
  sites                 Site[]
  activities            Activity[]
  ratingCodes           RatingCode[]
  reviews               Review[]
  reviewSubjectRatings  ReviewSubjectRating[]
  packageCostBreakdowns PackageCostBreakdown[]
  packageCostLineItems  PackageCostLineItem[]
  bookingCostBreakdowns BookingCostBreakdown[]
  bookingCostLineItems  BookingCostLineItem[]
  hotelRatings          HotelRating[]
  restaurantRatings     RestaurantRating[]
  packageItineraryDays  PackageItineraryDay[]
  wizardProgressEvents  WizardProgressEvent[]

  @@map("organizations")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String?
  role               Role      @default(TOURIST)
  emailVerified      Boolean   @default(false)
  image              String? // better-auth: avatar URL
  phone              String? // E.164 -- WhatsApp/SMS addressing (DR-013)
  preferredLocale    Locale    @default(EN)
  isAnonymous        Boolean?  @default(false) // better-auth `anonymous` plugin (DR-016 guest checkout)
  organizationId     String?   @db.Uuid
  mustChangePassword Boolean   @default(false) // set true for admin-created accounts with a generated temp password (DR-026)
  // Set via a databaseHooks.session.create.after hook in src/lib/auth.ts
  // (a plain prisma.user.update, not part of better-auth's own managed
  // payload -- no additionalFields registration needed) -- the moment a
  // new Session row is created, i.e. an actual sign-in, not just any
  // authenticated request. Powers the "Last login" column on
  // /staff/admin/users.
  lastLoginAt        DateTime?
  // DR-084: dormancy after 30 days without a sign-in (staff roles only --
  // TOURIST accounts are anonymous-session-based, this doesn't apply, and
  // SUPERADMIN is excluded from the sweep, see authRepository
  // .markDormantUsers). null = active; set = sign-in is actively blocked
  // (databaseHooks.session.create.before in lib/auth.ts) until an admin
  // reactivates. Distinct from deletedAt -- automatic (the sweep), not
  // manual (an admin's own Deactivate click).
  inactiveAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // DR-141: a manual "Deactivate" (deletedPermanently: false, same as a
  // bare-tourist client record's own soft-delete, DR-085/036) is reversible
  // via reactivateUser, same as inactiveAt above -- but a manual "Delete"
  // (deletedPermanently: true, SUPERADMIN-only) is not; reactivateUser
  // refuses once this is set. Both read the same as "gone" everywhere
  // deletedAt is already checked (resolveSession, findUserByEmail,
  // findUserById) -- this column only decides whether recovery is possible.
  deletedAt          DateTime?
  deletedPermanently Boolean   @default(false)

  memberships          Membership[]
  sessions             Session[]
  accounts             Account[]
  bookings             Booking[]
  ownedVehicles        Vehicle[]
  driverProfile        DriverProfile?
  guideProfile         GuideProfile?
  guideAssignments     Assignment[]
  reviewSubjectRatings ReviewSubjectRating[]
  hotelRatings         HotelRating[]
  restaurantRatings    RestaurantRating[]

  @@index([organizationId])
  @@map("users")
}

// A user's role within a specific organization (multi-tenant membership).
// DR-026: real multi-role source of truth for staff accounts created via the
// admin user-management surface -- one row per (user, org, role) a user
// holds simultaneously. User.role stays a single "primary" role used
// unchanged by tourist/guest self-signup, which never gets a Membership row.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, role])
  @@index([organizationId])
  @@map("organization_members")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// --------------------------------------------------------------- finance
// Per-country, effective-dated tax (DR-006 / BR-01). Rate in basis points.
model TaxRate {
  id        String    @id @default(uuid()) @db.Uuid
  country   String // ISO-3166 alpha-2
  taxType   String    @default("VAT")
  rateBp    Int // 1600 = 16.00%
  validFrom DateTime  @default(now())
  validTo   DateTime?

  @@index([country, taxType, validFrom])
  @@map("tax_rates")
}

// Settings module (DR-042): the platform's own commission on every online
// payment processed ("the cost to maintain the platform") -- a single
// global rate, not per-country (unlike TaxRate). Platform-wide reference
// data, no organizationId/RLS, same precedent as TaxRate. Informational
// only: Invoice.platformFeeMinor is a computed split of the existing total,
// never added on top of what the customer pays (see Invoice below).
model PlatformRate {
  id        String    @id @default(uuid()) @db.Uuid
  rateBp    Int // 500 = 5.00%
  validFrom DateTime  @default(now())
  validTo   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([validFrom])
  @@map("platform_rates")
}

// Settings module (DR-198): a guest whose travel date is under
// thresholdDays away pays in full only (no deposit option) with a
// surchargeRateBp increase on top -- see Booking.lateBookingSurchargeBp/
// Invoice.lateBookingSurchargeMinor/depositAllowed for where this gets
// snapshotted and applied. Platform-wide, effective-dated, same
// no-organizationId/no-RLS precedent as TaxRate/PlatformRate above.
model LateBookingRate {
  id              String    @id @default(uuid()) @db.Uuid
  thresholdDays   Int
  surchargeRateBp Int // 500 = 5.00%
  validFrom       DateTime  @default(now())
  validTo         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([validFrom])
  @@map("late_booking_rates")
}

// CMS module (DR-071): staff-editable guest-site content, replacing what
// used to be hardcoded JSX/TS literals in src/app/(guest)/{about,faq}. Added
// as an unused scaffold in DR-042 (the "(DR-043)" citation this comment used
// to carry was a stale mislabel -- DR-042 is the actual origin, see its row
// in DECISION_LOG.md); DR-071 is what actually builds the module. No
// organizationId/RLS -- same precedent as TaxRate/CountryRegulation, and
// consistent with the guest site's existing single-primary-org convention
// (getPrimaryOrgId() already resolves one global org for every guest page,
// so there's no per-tenant guest-content story to preserve). Write is
// SUPERADMIN-only (cms.write, enforced in cms/service.ts).
// `locale` (DR-071) lets About/FAQ carry real, independently-written French
// content rather than a literal translation bolted on later -- one row per
// key+locale, mirroring next-intl's per-locale-file convention.
// DR-162 renamed the `content` module to `cms` (and this model from
// SiteContent) as Phase 1 of a broader CMS expansion (staff-managed text +
// media across the whole guest site, not just About/FAQ) -- `@@map` is
// deliberately left pointing at the original table name: this is a
// TS-facing/Prisma-Client rename only, not a migration, since the table
// holds live production About/FAQ content. `key` is no longer only "about"
// -- it's meant to take dotted/namespaced keys for other pages/sections
// (e.g. "contact.intro") as those get built out in later phases.
// DR-163 (Phase 2, Home hero) adds `eyebrow`, additive/nullable -- the
// existing About-page row leaves it null; a hero slide's short label above
// the headline is the first consumer that actually needs a 3rd text field
// beyond title/body.
model CmsTextBlock {
  id              String   @id @default(uuid()) @db.Uuid
  key             String // e.g. "about", "contact.intro", "home.hero.<slotKey>"
  locale          String   @default("en")
  title           String
  body            String   @db.Text
  eyebrow         String?
  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid

  @@unique([key, locale])
  @@map("site_content")
}

// Same precedent as CmsTextBlock, but repeated rows (one per Q&A) instead of
// a single-row-per-key blob. `locale` (DR-071): each FAQ entry is one
// question+answer in one language -- EN and FR entries are independent rows
// with their own sortOrder, not a shared row with two body columns. Renamed
// from FaqEntry in DR-162, same "TS-facing rename only, @@map unchanged"
// reasoning as CmsTextBlock above.
model CmsFaqEntry {
  id        String   @id @default(uuid()) @db.Uuid
  question  String
  answer    String   @db.Text
  locale    String   @default("en")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, sortOrder])
  @@map("faq_entries")
}

// New in DR-162 -- the generic image/video building block later CMS phases
// will use for staff-managed media across the guest site (Home hero slides,
// Gallery, etc.), so those phases don't each need their own table. Not yet
// given a repository/service method or any UI -- nothing calls this table
// until a specific page is actually wired to it. `mediaType` is a plain
// String validated in cms/domain.ts (zod), the same convention as `locale`
// above, rather than a Postgres enum, so adding a third media type later is
// a code-only change. `(page, slotKey)` is unique so a specific slide/slot
// (e.g. page="home-hero", slotKey="slide-1") can be upserted in place; a
// free-form list (e.g. Gallery) uses a stable per-item id as its slotKey.
// DR-163 (Phase 2, Home hero) adds `overlayGradient`, additive/nullable --
// the per-slide CSS gradient overlay, staff-editable (explicit user
// decision: flexible over design-review-guarded). Stored here rather than
// on CmsTextBlock since it's a visual property of the slide, applying
// whether that slide has an image or a video. Also makes `mediaType`/`url`
// nullable (design correction made before this table was ever populated in
// production -- no data at risk): dynamic add/remove (DR-163) means a
// freshly-added slide can exist with its text filled in but no media
// chosen yet, which the original non-nullable columns couldn't represent
// without a placeholder-URL hack.
// DR-167 (Gallery becomes dynamic/staff-editable, and the single source of
// truth for site name/country -- also read by the plan-my-trip wizard's
// "sites to visit" step, replacing the old static `DESTINATION_SITES`)
// adds `name`/`country`, additive/nullable -- only meaningful for
// page='gallery' rows (null/unused for 'home-hero'). `country` is a plain
// zod-validated string (against OPERATING_COUNTRY_CODES), same "no
// Postgres enum" convention as `mediaType`. Also renames `caption` ->
// `description` (`@map("caption")`, pure TS-facing rename, same
// zero-data-risk technique as the DR-162 SiteContent->CmsTextBlock rename
// -- the column itself is untouched) since a gallery site's blurb reads
// more naturally as "description" than "caption" once it's describing the
// place itself, not just annotating a photo.
// DR-200 adds `platform` (nullable, additive -- every existing home-hero/
// gallery/partners row keeps `platform=null`, unaffected) for the new
// page='social-links' rows: one of CMS_SOCIAL_PLATFORMS (facebook,
// instagram, x, whatsapp, tiktok), a plain zod-validated string against a
// fixed enum, same "no Postgres enum" convention as `mediaType`/`country`
// -- reused to look up the matching hand-drawn SVG icon in the guest
// footer rather than storing icon markup in the DB. `url` doubles as the
// profile link for these rows (already nullable -- unset until staff adds
// the real handle, same "no accounts set up yet" placeholder convention
// the old hardcoded footer array used).
model CmsMediaItem {
  id              String   @id @default(uuid()) @db.Uuid
  page            String // e.g. "home-hero", "gallery", "social-links"
  slotKey         String // e.g. "slide-1", or a stable per-item id for a free list like Gallery
  mediaType       String? // 'image' | 'video', null until media is chosen
  url             String?
  description     String?  @map("caption")
  overlayGradient String? // e.g. "linear-gradient(100deg, rgba(...) 0%, ...)"
  name            String? // gallery sites only -- staff-editable display name
  country         String? // gallery sites only -- one of OPERATING_COUNTRY_CODES
  platform        String? // social-links only -- one of CMS_SOCIAL_PLATFORMS
  slug            String? // gallery sites only -- staff-editable, human-readable id
                          // for the site's shareable /gallery/[slug] link (DR-251);
                          // null until staff sets one, falls back to slotKey
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid

  @@unique([page, slotKey])
  // Postgres treats multiple NULLs as distinct, so any number of
  // not-yet-slugged items can coexist under one page with no conflict --
  // this only actually constrains once two items on the same page both set
  // the same real slug.
  @@unique([page, slug])
  @@index([page, sortOrder])
  @@map("cms_media_items")
}

// Homepage "Where we operate" map (DR-202) -- which African countries get
// individually highlighted/interactive on the homepage map, plus their
// hover-tooltip snapshot facts (capital/languages/currency/population/area).
// Platform-wide, no organizationId/RLS -- same precedent as CmsTextBlock/
// CmsFaqEntry. `countryCode` (ISO 3166-1 alpha-2) is validated in
// cms/domain.ts against src/lib/africa-country-ids.ts's full 55-country
// AFRICA_COUNTRIES list, not just the 4 countries this platform actually
// operates in for booking/visa/tax purposes (OPERATING_COUNTRY_CODES) --
// this table is a decorative map highlight, not a business-eligibility
// list, so adding a row here does not open a country for real bookings.
model CmsOperatingCountry {
  id              String   @id @default(uuid()) @db.Uuid
  countryCode     String   @unique
  capital         String
  languages       String
  currency        String
  population      String
  areaKm2         String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid

  @@index([sortOrder])
  @@map("cms_operating_countries")
}

// Platform-wide reference data, one row per country (Immigration Module,
// DR-034) -- NOT tenant-scoped (no organizationId), same "objective fact
// about a country, not operator-owned data" reasoning as TaxRate above; no
// RLS policy either, same precedent. Deliberately not effective-dated like
// TaxRate -- a single current snapshot per country, edited in place; a
// historical trail of who changed what lives in audit_logs, not here.
// Write access is SUPERADMIN-only (country_regulation.write in rbac.ts,
// enforced in immigration/service.ts -- PLATFORM_ADMIN is deliberately
// excluded, the first real behavioral gap between the two admin roles in
// this app). Read access goes to whoever processes visas (rbac.ts).
model CountryRegulation {
  id      String @id @default(uuid()) @db.Uuid
  country String @unique @db.VarChar(2) // ISO-3166 alpha-2, matches TaxRate.country/Traveler.nationality

  visaRequirements   String @db.Text // who needs what (e-visa/on-arrival/exempt) -- free text since nationality-by-nationality rules shift too often for a relational model here
  requiredDocuments  String @db.Text // free text checklist (passport validity window, photos, invitation letter, etc.)
  processingTimeDays Int? // typical turnaround; nullable, not every country publishes one figure

  entryConditions     String    @db.Text // yellow fever proof, health forms, quarantine rules, etc.
  immigrationFeeMinor Int? // integer minor units (BR-02), paired with feeCurrency -- never a bare number
  feeCurrency         Currency? // paired with immigrationFeeMinor -- both null together when no flat fee is published

  embassyName    String?
  embassyAddress String?
  embassyPhone   String?
  embassyEmail   String?

  healthRequirements  String  @db.Text // vaccination/malaria prophylaxis guidance
  travelAdvisories    String? @db.Text // current advisory summary -- nullable, not every country has an active one
  specialRestrictions String? @db.Text // e.g. DRC's BR-07 security-zone posture -- nullable, most countries have none

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("country_regulations")
}

// DR-159 (reverses DR-035): the RolePermission model (platform-wide,
// DB-backed (role, permission) grants, editable at runtime via
// /staff/admin/permissions) is removed -- what each role grants is a
// hardcoded, in-code map again (src/lib/rbac.ts's ROLE_PERMISSIONS).
// Destructive schema change (dropped the role_permissions table, 108
// pre-existing rows) applied by hand to the shared Neon DB with explicit
// user confirmation, verified via `psql`.

// ---------------------------------------------------------------- system
// Append-only. INSERT/UPDATE/DELETE grants are locked down in rls.sql.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String?  @db.Uuid
  // Plain string, not the Role enum -- this table is meant to outlive its
  // actors (same reasoning as actorUserId staying a bare, non-FK uuid after
  // DR-026's user deletions), and DR-032 confirmed why the enum shape
  // breaks that: 22 historical rows record `IMMIGRATION_OFFICER` actions
  // from before that role was removed entirely, which a real enum could
  // no longer represent once the value stopped existing.
  actorRole      String?
  action         String
  resourceType   String
  resourceId     String?
  organizationId String?  @db.Uuid
  ip             String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ------------------------------------------------------------ catalog (Vol. 1)
// Tenant-scoped. RLS policies in rls.sql enforce that a request only sees rows
// for the organization in the session GUC `app.org_id`.
model TourPackage {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @db.Uuid
  // Business-facing reference, e.g. PKG-00034, from a plain Postgres sequence
  // (package_reference_seq -- not representable in Prisma's schema DSL, see
  // src/modules/catalog/repository.ts), same coexists-alongside-the-id
  // pattern as Booking.bookingReference (DR-027).
  packageReference       String        @unique
  // DR-118: a personalized public URL segment generated once from `title`
  // at creation time (src/lib/slug.ts + a uniqueness loop in
  // catalog/repository.ts) -- never regenerated on a later title edit, so a
  // published package's guest-facing URL stays stable. Nullable only for
  // rows created before DR-118 (backfilled by hand,
  // scripts/backfill-package-slugs.ts); every package created from here on
  // always gets one, published or not.
  slug                   String?       @unique
  title                  String
  description            String
  country                String // ISO-3166 alpha-2, one of countries[] -- the PRIMARY/billing
  // country: matches TaxRate.country for invoicing, and is the sole driver of
  // finance/service.ts's resolveRatesForCost. A combo package's OTHER
  // countries live in countries[] below for display/filtering only -- never
  // read by tax/rate resolution (DR-114, mirrors Booking.customCountry vs
  // preferredCountries, DR-047).
  // Full set of countries this package touches (superset including
  // `country` above) -- display/filtering only, e.g. a guest filtering by
  // "Zambia" should also surface a Zambia+Zimbabwe combo package.
  countries              String[]      @default([])
  // Per-seat unit price, integer minor units (BR-02). Nullable since DR-039:
  // a brand-new package starts unpriced until the finance module's cost
  // breakdown computes it (or an admin override sets it) -- isBookable
  // treats null as not-bookable. Existing packages keep their pre-DR-039
  // value (grandfathered, no cost breakdown required retroactively).
  priceMinor             Int?
  // DR-134: the components financeService.saveCostBreakdown baked into
  // priceMinor (per seat, tax + platform-fee-inclusive) -- null for a
  // package priced any other way (pre-DR-134, or grandfathered). Lets
  // booking/invoicing detect "this price already includes tax + platform
  // fee" and skip resolving them live again, so a guest is never taxed
  // twice. priceSubtotalMinor is the tax/fee-exclusive base (base cost +
  // agency margin); the two rates are whatever was effective when this
  // package's cost breakdown was last saved.
  priceSubtotalMinor     Int?
  priceTaxRateBp         Int?
  pricePlatformFeeRateBp Int?
  currency               Currency
  durationDays           Int?
  // DR-068: optional hero image for the guest package card/detail page.
  // Nullable/additive -- no operator-supplied photography existed at first
  // (see CLAUDE.md Open Items), so every existing package stays imageless
  // until staff upload one; the guest UI renders an illustrated gradient
  // fallback in the meantime. Since DR-114, staff upload a real file
  // (`catalogService.uploadPackageImage`) rather than pasting a URL -- this
  // is a Vercel Blob `access: 'public'` URL (next.config.mjs's
  // `*.public.blob.vercel-storage.com` remotePattern, added DR-071), not a
  // local `/public/images/...` asset path. DR-172: up to 3 images (order =
  // display/slideshow order, first is the "cover" used wherever only one
  // image fits -- detail-page hero, opengraph-image); the cap itself is
  // enforced in catalog/domain.ts's zod schemas, not a DB constraint.
  // Renamed from the singular `imageUrl` -- safe as a clean rename (not an
  // add+backfill+drop) since no package had a real value yet (OI-12).
  imageUrls              String[]      @default([])
  tags                   PackageTag[] // interest-matching for the public quiz (DR-016)
  status                 PackageStatus @default(DRAFT)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  // Soft delete (DR-028) -- already existed, scaffolded but unused until now;
  // reads across this module already filter deletedAt: null.
  deletedAt              DateTime?

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departures            Departure[]
  costBreakdown         PackageCostBreakdown?
  itineraryTemplateDays PackageItineraryDay[]
  // DR-108: the (at most one, Booking.customizedPackageId is @unique)
  // TAILOR_MADE booking this package was created from, if any.
  customizedFromBooking Booking?
  // DR-180: which add-ons this package offers on the guest site.
  addonServices         PackageAddonService[]

  @@index([organizationId])
  @@map("tour_packages")
}

// A reusable day-by-day itinerary template for a package -- copied onto a
// fresh Itinerary's real, dated ItineraryDay rows the moment one is created
// for a booking against this package (itineraryService.createItinerary),
// so staff review/adjust an already-populated plan instead of building one
// from scratch every time. dayNumber is relative to the trip's start (day
// 1, day 2, ...), not a real calendar date -- the real date only exists
// once a specific booking's Departure.startDate is known. Deliberately
// mirrors ItineraryDay's shape (itinerary module) rather than being shared
// with it -- this is catalog-owned reference/template data, that one is a
// live per-booking record; duplicating the shape is simpler than the two
// modules depending on each other for one shared type. DR-119 removes
// plannedSites/estimatedTravelMinutes entirely (explicit user direction --
// plannedSites is superseded by activityIds below; estimatedTravelMinutes
// simply wasn't wanted) and adds hotelId/restaurantId, same "plain, un-FK'd
// scalar" precedent as activityIds -- catalog can't reference itinerary's
// Hotel/Restaurant tables without inverting the module dependency direction
// (itinerary -> catalog, never the reverse).
model PackageItineraryDay {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  tourPackageId   String   @db.Uuid
  dayNumber       Int
  departureTime   String?
  arrivalTime     String?
  pickupLocation  String?
  dropoffLocation String?
  // DR-116: real Activity ids (itinerary module) selected via a searchable
  // picker on the staff day form -- a plain, un-FK'd string array, same
  // "no cross-module relation" precedent as TourPackage.countries/
  // Booking.preferredCountries, since catalog can't reference itinerary's
  // tables without inverting the module dependency direction (see this
  // model's own comment above). Supersedes the free-text `activities`
  // column below for new/edited days; `activities` itself is left
  // untouched for any pre-DR-116 row that already has one.
  activities      String?  @db.Text
  activityIds     String[] @default([])
  // DR-119: real Hotel/Restaurant ids (itinerary module), same plain
  // scalar precedent as activityIds above -- one of each per day, picked
  // via a searchable single-select.
  hotelId         String?  @db.Uuid
  restaurantId    String?  @db.Uuid
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackage  TourPackage  @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)

  @@unique([tourPackageId, dayNumber])
  @@index([organizationId])
  @@index([tourPackageId])
  @@map("package_itinerary_days")
}

// A scheduled instance of a TourPackage. Capacity lives here (not on the
// package) because two departures of the same package can run different
// group/vehicle sizes.
//
// DR-028: tourPackageId is now nullable -- a "bespoke" departure (converted
// from an approved TAILOR_MADE Booking, see bookingService.convertToItinerary)
// has no TourPackage at all. Its country/price/currency are snapshotted
// directly onto customCountry/priceOverrideMinor/currency instead (catalog
// module cannot depend on the booking module -- see catalogService
// .createBespokeDeparture -- so these carry what a package join would
// otherwise have supplied). A bespoke departure is never publicly listed and
// exists solely so the existing Assignment machinery can attach to it.
model Departure {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  tourPackageId      String?         @db.Uuid
  startDate          DateTime
  endDate            DateTime?
  capacity           Int
  priceOverrideMinor Int? // null = inherit TourPackage.priceMinor/currency; for a bespoke departure, this IS the price (no package to inherit from)
  currency           Currency? // bespoke departures only -- a package-backed departure inherits TourPackage.currency
  customCountry      String?         @db.VarChar(2) // bespoke departures only -- ISO-3166 alpha-2, snapshotted from the originating Booking
  // Staff-entered pickup point (DR-029) -- feeds the assignment
  // recommendation engine's "distance from pickup" factor. Optional: most
  // departures won't have this set initially, and the engine degrades
  // gracefully (skips that factor) when it's missing.
  pickupLatitude     Float?
  pickupLongitude    Float?
  status             DepartureStatus @default(SCHEDULED)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackage  TourPackage? @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  assignments  Assignment[]

  @@index([organizationId])
  @@index([tourPackageId])
  @@map("departures")
}

// ---------------------------------------------------------- assignment (DR-018, Phase 2 Increment 2)
// Links a Departure to the vehicle/driver/guide staffing it. A departure can
// have several Assignment rows (one per vehicle) once its capacity exceeds a
// single vehicle's seatCapacity -- @@unique below just stops the same
// vehicle being double-entered for the same departure, not a 1:1 cap.
model Assignment {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  departureId     String   @db.Uuid
  vehicleId       String   @db.Uuid
  driverProfileId String   @db.Uuid
  guideUserId     String?  @db.Uuid // TOUR_GUIDE-role user; optional
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departure     Departure     @relation(fields: [departureId], references: [id], onDelete: Cascade)
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  guide         User?         @relation(fields: [guideUserId], references: [id])

  @@unique([departureId, vehicleId])
  @@index([organizationId])
  @@index([departureId])
  @@index([vehicleId])
  @@index([driverProfileId])
  @@map("assignments")
}

// A tourist's seat reservation on a Departure (PREDEFINED_PACKAGE), or a
// bespoke trip request with no fixed Departure (TAILOR_MADE, priced by staff
// via a quotation). A "hold" is not a separate entity — it's this same row
// with status=AWAITING_DEPOSIT and holdExpiresAt set; DB lazy expiry means
// any read that cares about current capacity treats an expired, not-yet-
// flipped AWAITING_DEPOSIT row as not occupying a seat (see booking module).
// A TAILOR_MADE booking has no departure/capacity to protect, so it never
// gets a holdExpiresAt even while AWAITING_DEPOSIT.
// Status alone encodes the ordinary lifecycle (cancellation/refund do NOT
// set deletedAt -- a cancelled booking's history still needs to survive for
// audit/reconciliation). deletedAt (DR-058) is a separate, explicit,
// SUPERADMIN-only "delete this booking" action, staff-triggered, never
// automatic -- it hides the row from every read path in this module
// immediately, then the row (and everything cascading off it) is
// permanently purged BOOKING_DELETION_RETENTION_DAYS days later by the
// same lazy sweepLifecycle convention this module already uses for
// hold-expiry/status transitions.
model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @db.Uuid
  origin                 BookingOrigin @default(PREDEFINED_PACKAGE)
  // Null only for a TAILOR_MADE booking -- no fixed departure exists yet.
  departureId            String?       @db.Uuid
  touristUserId          String        @db.Uuid
  seats                  Int
  status                 BookingStatus @default(DRAFT)
  holdExpiresAt          DateTime? // set only while status = AWAITING_DEPOSIT, and only for a PREDEFINED_PACKAGE booking
  // Seats * effective unit price for PREDEFINED_PACKAGE, snapshotted at hold
  // time. Null for TAILOR_MADE until staff sends a quotation (sendQuotation).
  priceMinor             Int?
  currency               Currency?
  // DR-134: whole-booking (already x seats) copy of the package's own
  // price*/priceSubtotalMinor fields, snapshotted at hold-creation time --
  // null whenever the departure used a manual priceOverrideMinor (no
  // package breakdown to copy from) or for a TAILOR_MADE booking (priced
  // via sendQuotation, never package-derived). invoicingService trusts
  // these instead of resolving tax/platform fee live when they're set, so
  // a guest whose package price already includes tax + platform fee is
  // never taxed twice.
  priceSubtotalMinor     Int?
  priceTaxRateBp         Int?
  pricePlatformFeeRateBp Int?
  // DR-198: snapshotted LateBookingRate.surchargeRateBp, at hold-creation
  // time (PREDEFINED_PACKAGE, against the Departure's startDate) or
  // tailor-made-request time (TAILOR_MADE, against customTravelStart) --
  // never re-evaluated later. Null = this booking's travel date was far
  // enough out that the surcharge doesn't apply; invoicingService reads
  // this snapshot rather than resolving the rate live, same "trust the
  // snapshot" convention as priceTaxRateBp/pricePlatformFeeRateBp above.
  lateBookingSurchargeBp Int?
  // Set when the add-ons wizard step is submitted, even choosing none --
  // gates invoice creation so the invoice's subtotal always reflects the
  // final add-on selection (see bookingService.getBillableTotal).
  addonsFinalizedAt      DateTime?
  // Snapshotted when add-ons are finalized (setAddons): true only if the
  // selection included the VISA_ASSISTANCE add-on. Drives whether the
  // Passport wizard step appears at all, and for how many travelers --
  // computed once here rather than re-joining BookingAddon -> AddonService
  // on every page render (see domain.isTravelerManifestComplete).
  requiresPassportUpload Boolean       @default(false)
  // Business-facing reference, e.g. shown on invoices/receipts and used as
  // the sole "find my booking" lookup key (+ the tour lead's last name --
  // see bookingService.lookupByBookingReference). DR-052 removed the
  // separate confirmationCode secret this coexisted with -- bookingReference
  // was already shown non-privately everywhere, so keeping both was
  // confusing without adding real protection. Pattern (DR-045): 6 chars,
  // 2-3 non-adjacent unique uppercase letters + unique digits -- see
  // src/modules/booking/domain.ts's generateBookingReference;
  // booking_reference_seq is dead (superseded by that same DR-045 change).
  bookingReference       String        @unique
  specialRequests        String?       @db.VarChar(1000)
  // TAILOR_MADE-only fields (all null/empty for a PREDEFINED_PACKAGE booking).
  customCountry          String?       @db.VarChar(2) // ISO-3166 alpha-2; drives tax-rate lookup in lieu of a Departure's package
  customTravelStart      DateTime?
  customTravelEnd        DateTime?
  customDescription      String?       @db.VarChar(2000)
  // Guest preference context for staff pricing a bespoke request (DR-046) --
  // NOT a matching/scoring input (the old quiz's package-ranking role is
  // gone entirely). Same PackageTag enum TourPackage.tags already uses.
  preferredTags          PackageTag[]  @default([])
  preferredSites         String[]      @default([])
  // DR-047: the full set of countries a guest ticked on /plan-my-trip
  // (customCountry above is just the first pick -- still the sole driver
  // of tax/visa lookups, unchanged). Contact email is booking-scoped, not
  // written onto User.email (which is better-auth-managed and @unique --
  // two different guests submitting the same real email would collide).
  preferredCountries     String[]      @default([])
  contactEmail           String?       @db.VarChar(320)
  // DR-057: the guest's own name at inquiry time, booking-scoped like
  // contactEmail above -- needed because /find-booking's last-name check
  // otherwise has nothing to match against for a TAILOR_MADE booking still
  // AWAITING_QUOTATION/QUOTATION_SENT (no Traveler/tour-lead row exists
  // until the setup wizard runs, which only starts after a quotation is
  // accepted). Not written onto User.name, which the wizard's contact step
  // already sets separately for account-profile purposes.
  contactFirstName       String?       @db.VarChar(100)
  contactLastName        String?       @db.VarChar(100)
  // DR-048: guest-expressed add-on interest (same AddonCode enum
  // BookingAddon/AddonService use for a real priced predefined-package
  // add-on) -- staff context only here, no priced AddonService/BookingAddon
  // row exists yet for a bespoke inquiry with no package to attach one to.
  preferredAddons        AddonCode[]   @default([])
  // ISO-3166 alpha-2 -- same convention as Traveler.nationality, but this
  // is the *guest's* own residence/citizenship (relevant to visa-assistance
  // interest), collected at inquiry time rather than per-traveler later.
  countryOfResidence     String?       @db.VarChar(2)
  citizenship            String?       @db.VarChar(2)
  // DR-108: staff can turn an AWAITING_QUOTATION TAILOR_MADE request into a
  // real, reusable DRAFT TourPackage, prefilled from the guest's own
  // plan-my-trip answers -- one package per booking (unique), set once and
  // never reassigned. Lives on Booking, not TourPackage, since booking
  // already legitimately depends on catalog (the reverse would be
  // circular).
  customizedPackageId    String?       @unique @db.Uuid
  // DR-207: guest self-service cancellation via /find-booking (heavily
  // regulated -- see bookingService.cancelForBookingLookup). reason/
  // contactEmail are guest-typed at cancellation time; refundTier is the
  // Cancellation & Refund Policy tier snapshotted at that moment (days-to-
  // departure obviously changes meaning after the fact) -- same "snapshot
  // the rate onto the row" precedent as lateBookingSurchargeBp above. All
  // three stay null for a staff-initiated cancellation (the existing
  // bookingService.cancel path) or the guest's own 30s-grace-window cancel
  // buttons -- neither collects this.
  cancellationReason        String?                 @db.VarChar(1000)
  cancellationContactEmail  String?                 @db.VarChar(320)
  cancellationRefundTier    CancellationRefundTier?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  // DR-058: see this model's own doc comment above -- a deliberate,
  // explicit, SUPERADMIN-only delete action, not an automatic side effect
  // of cancellation/refund.
  deletedAt              DateTime?

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departure         Departure?            @relation(fields: [departureId], references: [id], onDelete: Cascade)
  tourist           User                  @relation(fields: [touristUserId], references: [id], onDelete: Cascade)
  customizedPackage TourPackage?          @relation(fields: [customizedPackageId], references: [id], onDelete: SetNull)
  invoice           Invoice?
  travelers         Traveler[]
  addons            BookingAddon[]
  itinerary         Itinerary?
  ratingCode        RatingCode?
  review            Review?
  costBreakdown     BookingCostBreakdown?

  @@index([organizationId])
  @@index([departureId])
  @@index([touristUserId])
  @@index([status, holdExpiresAt]) // cheap index scan for the expiry sweep
  @@index([deletedAt]) // cheap index scan for the retention-purge sweep
  @@map("bookings")
}

// One row per seat on a Booking -- captures who is actually traveling.
// Exactly one Traveler per Booking has isTourLead = true (a solo booking's
// one traveler is trivially its own tour lead); only that traveler needs a
// passport upload (see Document).
model Traveler {
  id                       String   @id @default(uuid()) @db.Uuid
  organizationId           String   @db.Uuid
  bookingId                String   @db.Uuid
  firstName                String
  lastName                 String
  // Nullable (DR-111): required for a PREDEFINED_PACKAGE traveler (real,
  // immediate travel), but a TAILOR_MADE booking's plan-my-trip request
  // never collects real per-traveler age/nationality/passport data -- forcing
  // staff to assume/fabricate a value at setup time would be worse than
  // leaving it unknown. Enforced by bookingService.addTraveler
  // (requiresFullTravelerDetails), not the DB.
  age                      Int?
  sex                      Sex
  nationality              String? // ISO-3166 alpha-2, matches TourPackage.country
  idOrPassportNumber       String?
  phone                    String? // E.164 -- only ever collected for the tour lead
  // ISO-3166 alpha-2, same convention as nationality -- only ever collected
  // for the tour lead (the wizard's point of contact for the whole party).
  countryOfResidence       String?
  // Only ever collected for the tour lead -- distinct from Booking
  // .contactEmail (TAILOR_MADE-only, DR-047), since a PREDEFINED_PACKAGE
  // booking has no booking-level contact field of its own.
  email                    String?
  disabilities             String?
  allergies                String?
  drinkPreference          String?
  // Guides Module (DR-030) -- a guide's dashboard needs this for their
  // assigned travelers; nothing captured it before.
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  isTourLead               Boolean  @default(false)
  passportDocumentId       String?  @unique @db.Uuid
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking          Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passportDocument Document?        @relation(fields: [passportDocumentId], references: [id])
  visaApplication  VisaApplication?

  @@index([organizationId])
  @@index([bookingId])
  @@map("travelers")
}

// ------------------------------------------------------------- visa (DR-019, Phase 2 Increment 3)
enum VisaStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// The destination country's own government/immigration processing fee,
// tracked separately from the guest-facing VISA_ASSISTANCE add-on charge
// (DR-184) -- collected out-of-band, never a Payment/Invoice line.
enum VisaFeePaymentStatus {
  NOT_REQUESTED
  REQUESTED
  PAID
}

// DR-210 (explicit user request): a manual, facilitator-set status for the
// granted visa document, independent of whether `documentId` is actually
// set -- same "staff-toggled, not system-derived" shape as
// VisaFeePaymentStatus above. Lets a facilitator mark a document RECEIVED
// (handled outside the system -- in person, by a separate email thread --
// with nothing to upload here) or NOT_REQUIRED (this country/traveler never
// needed one), not just MISSING/uploaded. "Request documents" on
// /staff/visa-queue gates on this field now, not on `documentId !== null`;
// the "View" link there still gates on `documentId !== null` regardless of
// this status, since that's the only thing that determines whether a real
// file exists to view.
enum VisaDocumentStatus {
  MISSING
  RECEIVED
  NOT_REQUIRED
}

// A per-traveler visa workflow, staged SUBMITTED -> APPROVED/REJECTED, with a
// REJECTED application resubmittable back to SUBMITTED (DR-025). Traveler
// identity fields are snapshotted here (not joined live) -- originally so
// IMMIGRATION_OFFICER's country-scoped list never needed booking.read; that
// role was removed in DR-032, but the snapshot stays since
// VISA_FACILITATOR's own queue (DR-031) also benefits from it.
model VisaApplication {
  id                         String               @id @default(uuid()) @db.Uuid
  organizationId             String               @db.Uuid
  travelerId                 String               @unique @db.Uuid
  country                    String // ISO-3166 alpha-2, destination -- snapshotted from the departure's package at submit time
  travelerFirstName          String
  travelerLastName           String
  travelerNationality        String
  travelerIdOrPassportNumber String
  status                     VisaStatus           @default(SUBMITTED)
  rejectionReason            String?              @db.VarChar(500) // set when status becomes REJECTED; cleared on resubmit and on a later APPROVED decision -- durable history of a past rejection lives in audit_logs, not here (DR-025)
  resubmissionCount          Int                  @default(0) // display-only counter, bumped by repository.resubmit -- not itself a business rule
  documentId                 String?              @unique @db.Uuid // the granted visa doc
  documentFileName           String?              @db.VarChar(255) // DR-213: the original uploaded filename (e.g. "visa_approval.pdf"), shown next to the "View" link on /staff/visa-queue -- set alongside documentId on upload, cleared alongside it on resubmit
  documentStatus             VisaDocumentStatus   @default(MISSING) // DR-210: facilitator-set, independent of documentId -- see enum comment
  submittedAt                DateTime             @default(now())
  decidedAt                  DateTime?
  // DR-184: the destination country's government/immigration fee, snapshotted
  // from CountryRegulation at (re)submission time -- frozen once set, never
  // retroactively updated by a later CountryRegulation edit. Re-snapshotted on
  // resubmission only while feePaymentStatus is still NOT_REQUESTED (once
  // staff has requested/collected it, resubmission must not silently change
  // the number). Collected entirely out-of-band -- no Payment/Invoice link.
  governmentFeeMinor         Int?
  governmentFeeCurrency      Currency?
  feePaymentStatus           VisaFeePaymentStatus @default(NOT_REQUESTED)
  feeRequestedAt             DateTime?
  feePaidAt                  DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  traveler     Traveler     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  document     Document?    @relation(fields: [documentId], references: [id])

  @@index([organizationId])
  @@index([country])
  @@map("visa_applications")
}

// Generic document reference -- object storage holds the bytes, this table
// holds only metadata (Documents rule, CLAUDE.md). Reusable by Phase 2 visa
// documents later; `kind` is a plain string (not an enum) so that doesn't
// need a migration. blobPathname is never sent to the client -- downloads go
// through an authenticated route that streams the bytes server-side.
// `expiresAt`/`vehicleId`/`driverProfileId` added in DR-017 (Phase 2
// Increment 1) for compliance documents (vehicle registration/insurance/
// inspection, driver license) -- unused by PASSPORT rows. A vehicle/driver
// can have several compliance documents with different expiries, so the FK
// lives on this (many) side, the mirror image of Traveler.passportDocumentId
// (a 1:1, FK on the "one" side) -- both are the natural Prisma shape for
// their own multiplicity, not an inconsistency.
model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  kind             String // "PASSPORT" | "VEHICLE_REGISTRATION" | "VEHICLE_INSURANCE" | "VEHICLE_INSPECTION" | "DRIVER_LICENSE" | "VISA"
  blobPathname     String // Vercel Blob pathname, access: 'private' -- never sent to the client
  contentType      String
  sizeBytes        Int
  uploadedByUserId String    @db.Uuid
  expiresAt        DateTime? // compliance documents only
  vehicleId        String?   @db.Uuid
  driverProfileId  String?   @db.Uuid
  guideProfileId   String?   @db.Uuid // GUIDE_CERTIFICATION docs (DR-030)
  createdAt        DateTime  @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  traveler        Traveler?
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverProfile   DriverProfile?   @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  guideProfile    GuideProfile?    @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  visaApplication VisaApplication?

  @@index([organizationId])
  @@index([vehicleId])
  @@index([driverProfileId])
  @@index([guideProfileId])
  @@map("documents")
}

// ------------------------------------------------------------- fleet (DR-017, Phase 2 Increment 1)
// Foundational data for Phase 2 (fleet + compliance, DR-017); linked to
// Departure via Assignment starting DR-018. GPS v1 (later increment) will
// attach here too.
model Vehicle {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  ownerId        String?            @db.Uuid // VEHICLE_OWNER user; null = operator-owned
  plateNumber    String
  vin            String? // chassis/VIN (DR-029) -- distinct from plateNumber, not every jurisdiction requires it up front
  make           String
  model          String
  year           Int?
  vehicleType    String // open-ended (sedan/minibus/4x4/boat...) -- varies too much across NA/DRC for an enum
  seatCapacity   Int
  status         VehicleStatus      @default(ACTIVE)
  // DR-082: usage-recency, independent of `status` above -- see
  // AvailabilityStatus's own comment. lastActiveAt seeds from createdAt
  // (a brand-new vehicle isn't "inactive" on day one) and is bumped to
  // now() whenever src/lib/fleet-availability.ts's sync runs against it.
  availability   AvailabilityStatus @default(AVAILABLE)
  lastActiveAt   DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              User?               @relation(fields: [ownerId], references: [id])
  documents          Document[]
  assignments        Assignment[]
  maintenanceRecords MaintenanceRecord[]
  starlinkKit        StarlinkKit?

  @@index([organizationId])
  @@index([ownerId])
  @@map("vehicles")
}

// 1:1 with a DRIVER-role User -- compliance data doesn't belong on the
// auth-owned User model (module-boundary rule, CLAUDE.md). deletedAt
// (DR-059) is a deliberate, explicit, SUPERADMIN-only "delete this driver"
// action -- distinct from `status`, which is the ordinary
// ACTIVE/SUSPENDED deactivation toggle every staff fleet.write caller uses.
model DriverProfile {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  userId           String             @unique @db.Uuid
  licenseNumber    String
  licenseExpiresAt DateTime?
  // ISO-639-1 codes, e.g. ["en","fr"] (DR-029).
  languages        String[]           @default([])
  status           DriverStatus       @default(ACTIVE)
  // DR-082: usage-recency, independent of `status` -- see
  // AvailabilityStatus's own comment.
  availability     AvailabilityStatus @default(AVAILABLE)
  lastActiveAt     DateTime           @default(now())
  // Live-recomputed from ReviewSubjectRating on every new Review (DR-037) --
  // null until the first rating, never incremented. Feeds
  // assignmentService.recommendAssignment's ordering.
  averageRating    Float?
  ratingCount      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  assignments   Assignment[]
  reviewRatings ReviewSubjectRating[]

  @@index([organizationId])
  @@map("driver_profiles")
}

// Guides Module (DR-030). 1:1 with a TOUR_GUIDE-role User, same module-
// boundary reasoning as DriverProfile. Note: Assignment.guideUserId still
// points directly at User (unchanged, pre-existing FK) rather than at this
// table's id -- this profile is a satellite of compliance/skill data looked
// up by userId, not the join target for assignments. Per-departure "is this
// guide free on these specific dates" eligibility is still computed live
// from Assignment overlap data (recommendAssignment), never stored --
// `availability` below (DR-082) is a different, general-purpose "how
// recently has this guide worked at all" status, which IS stored.
model GuideProfile {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @unique @db.Uuid
  // ISO-639-1 codes, e.g. ["en","fr"], same convention as DriverProfile.
  languages      String[]           @default([])
  // DR-245: was freeform (e.g. "wildlife", "gorilla trekking", "cultural") --
  // now the same PackageTag enum TourPackage.tags uses, a controlled
  // vocabulary a guide's specialties can be matched against a package's tags
  // with (see assignmentService.recommendAssignment). No production data
  // existed in this column at the time of the change (confirmed via a
  // direct query), so no migration/backfill was needed.
  specialties    PackageTag[]       @default([])
  status         GuideStatus        @default(ACTIVE)
  // DR-082: usage-recency, independent of `status` -- see
  // AvailabilityStatus's own comment.
  availability   AvailabilityStatus @default(AVAILABLE)
  lastActiveAt   DateTime           @default(now())
  // Live-recomputed from ReviewSubjectRating on every new Review (DR-037) --
  // null until the first rating, never incremented. Written by userId (see
  // fleetService.recordGuideRatingAggregateByUserId), since
  // ReviewSubjectRating.guideUserId points at User, not this table's id.
  averageRating  Float?
  ratingCount    Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // DR-059: same deliberate, explicit, SUPERADMIN-only delete action as
  // DriverProfile.deletedAt -- see that field's own comment.
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@index([organizationId])
  @@map("guide_profiles")
}

// ---------------------------------------------------------- fleet: maintenance history (DR-029)
// A simple append-only log per vehicle -- no scheduled/due-date concept yet
// (that would need a maintenance-interval policy this spec doesn't define),
// just a record of what was done and when. Feeds the assignment
// recommendation engine's "maintenance status" factor (recency as a proxy
// for risk) alongside the existing VehicleStatus.MAINTENANCE hard gate.
model MaintenanceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  vehicleId      String    @db.Uuid
  performedAt    DateTime
  description    String
  costMinor      Int? // integer minor units (BR-02), paired with currency below -- never a bare number
  currency       Currency?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([vehicleId])
  @@map("maintenance_records")
}

enum StarlinkStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

// A Starlink kit is a fleet resource in its own right (DR-029), 1:1 with the
// Vehicle it's currently mounted in (nullable -- a kit can be unassigned,
// e.g. newly received or being serviced). lastLatitude/lastLongitude/
// lastLocationAt are staff-entered for now, not a live feed -- there is no
// real Starlink API integration yet (no credentials, not in the approved
// stack table), matching how Resend/WhatsApp/Africa's Talking each started
// as a stub before real credentials existed (OI-05/06/07). Real live
// tracking is a future open item, not modeled here.
model StarlinkKit {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  kitId          String         @unique // Starlink's own serial/kit identifier, staff-entered
  status         StarlinkStatus @default(ACTIVE)
  vehicleId      String?        @unique @db.Uuid
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organizationId])
  @@map("starlink_kits")
}

// ------------------------------------------------------- itinerary (DR-033)
// Every itinerary is 1:1 with a Booking -- "the operational plan for the
// entire tour" per the spec. Deliberately does NOT duplicate
// vehicle/driver/guide assignment data (already owned by the assignment
// module, keyed by Departure, and shared across every booking on a
// PREDEFINED_PACKAGE departure) -- itineraryService reads that through
// assignmentService/fleetService's public interfaces instead. Hotels/
// restaurants are lightweight reusable reference entities (name + contact
// info only, no compliance tracking like the fleet module has), assigned
// via join tables since a trip can use several of each.
enum ItineraryStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model Itinerary {
  id                       String          @id @default(uuid()) @db.Uuid
  organizationId           String          @db.Uuid
  bookingId                String          @unique @db.Uuid
  status                   ItineraryStatus @default(DRAFT)
  notes                    String?         @db.Text
  // Trip-level (not per-traveler -- see Traveler.emergencyContactName et al,
  // DR-030, for that) -- e.g. a local ranger station or tour-company
  // emergency line relevant to the whole group.
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  approvedAt               DateTime?
  approvedByUserId         String?         @db.Uuid
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  days         ItineraryDay[]

  @@index([organizationId])
  @@map("itineraries")
}

// One row per calendar day of the trip -- "daily schedule"/"activities for
// each day"/"planned tourist sites... per day" all live here, distinct from
// Itinerary's trip-level fields. departureTime/arrivalTime are plain
// "HH:MM" strings (no existing time-of-day type in this schema, and
// timezone precision isn't needed for a same-day local activity time).
// dayNumber is server-computed from the trip's start date, never client-
// supplied (see AddItineraryDayInput/service addDay -- explicit user
// direction: a manually-typed day number was redundant with the date and
// error-prone). hotelId/restaurantId (DR-083): per-day lodging/dining
// assignment, replacing the old itinerary-wide ItineraryHotel/
// ItineraryRestaurant join tables -- a real multi-day safari itinerary
// stays at a different lodge/eats at a different restaurant per day, not
// one fixed pair for the whole trip.
model ItineraryDay {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @db.Uuid
  itineraryId            String   @db.Uuid
  dayNumber              Int
  date                   DateTime
  departureTime          String?
  arrivalTime            String?
  pickupLocation         String?
  dropoffLocation        String?
  // Independent of the free-text pickupLocation/dropoffLocation above --
  // those stay as the human label, these are the actual pin (same
  // pattern as Departure.pickupLatitude/pickupLongitude, DR-077). Optional:
  // most days won't have one set, same degrade-gracefully posture.
  pickupLatitude         Float?
  pickupLongitude        Float?
  dropoffLatitude        Float?
  dropoffLongitude       Float?
  activities             String?  @db.Text
  // DR-120: real Activity ids (this module's own table -- no cross-module
  // workaround needed here, unlike catalog's PackageItineraryDay.activityIds).
  // Carried across from the package's day template by
  // itineraryService.createItinerary's template-copy step, same as
  // hotelId/restaurantId (DR-119).
  activityIds            String[] @default([])
  estimatedTravelMinutes Int?
  notes                  String?  @db.Text
  hotelId                String?  @db.Uuid
  restaurantId           String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itinerary    Itinerary          @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  hotel        Hotel?             @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  restaurant   Restaurant?        @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  sites        ItineraryDaySite[]

  @@unique([itineraryId, dayNumber])
  @@index([organizationId])
  @@index([itineraryId])
  @@index([hotelId])
  @@index([restaurantId])
  @@map("itinerary_days")
}

// Replaces the old free-text ItineraryDay.plannedSites (removed) with a
// real, staff-ordered relation to Site -- needed so a map/route feature has
// actual geocoded stops to work with instead of an unconstrained string.
// Unlike ItineraryDay.dayNumber (server-computed, deliberately not
// client-settable -- see the comment on that field), `sequence` here IS
// staff-settable: staff pick which sites and in what order for the day.
model ItineraryDaySite {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  itineraryDayId String   @db.Uuid
  siteId         String   @db.Uuid
  sequence       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itineraryDay ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([itineraryDayId, sequence])
  @@unique([itineraryDayId, siteId])
  @@index([organizationId])
  @@index([itineraryDayId])
  @@index([siteId])
  @@map("itinerary_day_sites")
}

model Hotel {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  country        String    @db.VarChar(2)
  address        String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  latitude       Float?
  longitude      Float?
  // Staff-only 5-star rating (not a tourist-facing concept) -- live-
  // recomputed on every HotelRating submission, same pattern as
  // DriverProfile/GuideProfile/Organization's own averageRating/ratingCount.
  averageRating  Float?
  ratingCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  days             ItineraryDay[]
  ratings          HotelRating[]
  // DR-116: operational-rate rows (finance module) that reference this hotel.
  // HotelRate itself stays a platform-wide, un-RLS'd table -- see its own
  // comment for why this cross-module FK doesn't change that.
  operationalRates HotelRate[]

  @@index([organizationId])
  @@map("hotels")
}

model Restaurant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  country        String    @db.VarChar(2)
  address        String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  latitude       Float?
  longitude      Float?
  // Staff-only 5-star rating -- same precedent as Hotel.averageRating above.
  averageRating  Float?
  ratingCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  days             ItineraryDay[]
  ratings          RestaurantRating[]
  // DR-131: operational-rate rows (finance module) that reference this
  // restaurant -- same "cross-module FK, still platform-wide/un-RLS'd"
  // precedent as Hotel.operationalRates above.
  operationalRates RestaurantRate[]

  @@index([organizationId])
  @@map("restaurants")
}

// DR-083: staff-managed list of named tourist sites/attractions per country,
// used to populate the daily-schedule "planned sites" picker instead of
// free-typed text -- same "lightweight reusable reference entity" precedent
// as Hotel/Restaurant above (name + country only, itinerary.write-gated
// CRUD), not a full attraction/POI system.
model Site {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  country        String    @db.VarChar(2)
  // Cascading with country in the staff form (src/lib/provinces.ts) for the
  // 4 operating countries; free text for any other. city is a real optional
  // field (explicit user direction) -- a site can be a park/region with no
  // proper town attached.
  province       String
  city           String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Soft-delete (added alongside ItineraryDaySite): once a Site can be
  // referenced by a day's stop list, a hard delete would either FK-violate
  // or silently corrupt historical days -- same fix Hotel/Restaurant
  // already have. deleteSite becomes an update, not a delete.
  deletedAt      DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dayUsages    ItineraryDaySite[]
  activities   Activity[]

  @@unique([organizationId, country, name])
  @@index([organizationId, country])
  @@map("sites")
}

// DR-116: a Site's own reference list of things to do there -- one Site can
// have many Activities. hasEntranceFee is an informational flag only (does
// this activity typically require paying to get in); the actual priced
// operational rate for one lives in finance's ActivityFee, which references
// an Activity by id rather than duplicating a free-text name. Soft-delete
// (matches Hotel/Site) since an ActivityFee can reference this row.
model Activity {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  siteId         String    @db.Uuid
  name           String
  hasEntranceFee Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  activityFees ActivityFee[]

  @@index([organizationId])
  @@index([siteId])
  @@map("site_activities")
}

// Staff-only hotel rating (distinct from the tourist-facing ratings module's
// DRIVER/GUIDE reviews) -- one row per (hotel, staff rater), overwritten on
// each revisit rather than accumulating a new row per visit, per explicit
// user choice. TOUR_GUIDE/DRIVER are scoped in itinerary/service.ts to only
// rate a hotel actually assigned to one of their own toured itineraries;
// TOUR_OPERATOR/PLATFORM_ADMIN (unscoped itinerary managers) can rate any.
model HotelRating {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  hotelId        String   @db.Uuid
  raterUserId    String   @db.Uuid
  rating         Int
  comment        String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rater        User         @relation(fields: [raterUserId], references: [id], onDelete: Cascade)

  @@unique([hotelId, raterUserId])
  @@index([organizationId])
  @@index([hotelId])
  @@map("hotel_ratings")
}

// Restaurant counterpart to HotelRating -- identical shape/rules.
model RestaurantRating {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  restaurantId   String   @db.Uuid
  raterUserId    String   @db.Uuid
  rating         Int
  comment        String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rater        User         @relation(fields: [raterUserId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, raterUserId])
  @@index([organizationId])
  @@index([restaurantId])
  @@map("restaurant_ratings")
}

// Org-scoped catalog of priced add-on services (photography, video,
// translator, visa assistance) -- same family as TourPackage.
model AddonService {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           AddonCode
  name           String
  description    String
  priceMinor     Int
  currency       Currency
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingAddons BookingAddon[]
  packages      PackageAddonService[]

  @@index([organizationId])
  @@map("addon_services")
}

// DR-180: which add-ons a given TourPackage offers on the guest site --
// previously add-ons were shown uniformly to every package (org+country
// scoped only, no per-package curation). Plain join table since
// TourPackage/AddonService both live in the catalog module (no
// cross-module-dependency implication). A package with zero rows here
// shows no add-ons at all on the guest booking flow -- DR-180's migration
// backfilled every pre-existing package against every then-active add-on so
// existing guest-facing behavior didn't change on deploy.
model PackageAddonService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  packageId      String   @db.Uuid
  addonServiceId String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package      TourPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  addonService AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)

  @@unique([packageId, addonServiceId])
  @@index([organizationId])
  @@map("package_addon_services")
}

// A selected add-on on a Booking. priceMinor/currency are snapshotted at
// selection time (same pattern as Booking.priceMinor) so a later catalog
// price change never mutates an already-selected add-on.
// DR-222: flightClass/airline/originAirportCode/destinationAirportCode
// (FLIGHT_TICKET) and dataAllowanceGb (ESIM) are the guest's variant
// selection, snapshotted as plain denormalized values rather than an FK
// into Airport/FlightFareRate -- same "snapshot the resolved fact, don't
// just FK it" convention as Invoice.lateBookingSurchargeRateBp, so a later
// Airport edit/deactivation never mutates an already-selected add-on. All
// five are nullable and only ever populated together, per addon code --
// null for every other AddonCode.
model BookingAddon {
  id                      String       @id @default(uuid()) @db.Uuid
  organizationId          String       @db.Uuid
  bookingId               String       @db.Uuid
  addonServiceId          String       @db.Uuid
  priceMinor              Int
  currency                Currency
  flightClass             FlightClass?
  airline                 String?
  originAirportCode       String?
  destinationAirportCode  String?
  dataAllowanceGb         Int?
  createdAt               DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonService AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingId])
  @@map("booking_addons")
}

// A 1:1 financial record for a Booking, created lazily on first access
// (invoicing/service.ts:getOrCreateInvoiceForBooking), not at hold time --
// tax jurisdiction + effective rate are snapshotted here so a later TaxRate
// change never mutates an already-issued invoice. DPO payments are stubbed
// this increment (OI-01 commercial terms still open) -- see Payment/gateway.ts.
model Invoice {
  id                         String        @id @default(uuid()) @db.Uuid
  organizationId             String        @db.Uuid
  bookingId                  String        @unique @db.Uuid
  currency                   Currency
  subtotalMinor              Int // = Booking.priceMinor at invoice-creation time
  // Coupons (DR-104): couponCode/discountBp are a snapshot of whichever
  // Coupon was applied at the time (same "snapshot onto the row, not a
  // live FK" convention as taxRateBp below) -- null on every invoice that
  // never had a coupon applied. discountMinor defaults to 0 (always a
  // valid number in the amount math below, coupon or not).
  couponCode                 String?
  discountBp                 Int?
  discountMinor              Int           @default(0)
  taxRateBp                  Int // snapshotted TaxRate.rateBp (BR-01/DR-006)
  taxMinor                   Int // tax on (subtotalMinor - discountMinor), not subtotalMinor
  totalMinor                 Int // (subtotalMinor - discountMinor) + taxMinor
  depositMinor               Int // 40% of totalMinor, half-up (DR-012)
  balanceMinor               Int // totalMinor - depositMinor (never independently rounded -- avoids drift)
  // Settings module (DR-042): the platform's commission, computed as an
  // informational split of totalMinor -- NEVER added to it. depositMinor/
  // balanceMinor/totalMinor are the customer's real amounts, unaffected by
  // this. Nullable: existing (pre-DR-042) invoices predate the feature and
  // are grandfathered, same precedent as TourPackage.priceMinor (DR-039).
  platformFeeMinor           Int?
  platformFeeRateBp          Int? // snapshotted PlatformRate.rateBp at invoice-creation time
  // DR-198: itemized late-booking surcharge, added on top of subtotal+tax+
  // platform fee (already folded into totalMinor/depositMinor above, not a
  // side split of them -- same "included, not added separately" convention
  // as platformFeeMinor). 0 on every invoice the surcharge doesn't apply to.
  lateBookingSurchargeMinor  Int           @default(0)
  // Snapshotted Booking.lateBookingSurchargeBp -- stored separately from the
  // computed lateBookingSurchargeMinor above (same "rate + amount, both
  // persisted" convention as taxRateBp/platformFeeRateBp) so applyCoupon/
  // removeCoupon can recompute amounts from the invoice row alone, without
  // needing the booking back in hand. Null = unaffected.
  lateBookingSurchargeRateBp Int?
  // DR-207: actual minor-unit amount computed from Booking.
  // cancellationRefundTier once the guest cancels via /find-booking -- same
  // "rate lives on Booking, money lives on Invoice" split as
  // lateBookingSurchargeMinor/lateBookingSurchargeRateBp above. Null until
  // that happens.
  refundAmountMinor         Int?
  // False forces depositMinor = totalMinor / balanceMinor = 0 (full payment
  // only) -- set from Booking.lateBookingSurchargeBp at invoice-creation
  // time, checked server-side by invoicing/domain.ts's canInitiatePayment
  // (the real gate; the guest UI hiding the deposit button is only a
  // convenience).
  depositAllowed             Boolean       @default(true)
  status                     InvoiceStatus @default(DRAFT)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking           Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments          Payment[]
  couponRedemptions CouponRedemption[]

  @@index([organizationId])
  @@map("invoices")
}

// Coupons (DR-104): a SUPERADMIN-managed, platform-wide percentage-discount
// code -- no organizationId/RLS, same precedent as TaxRate/PlatformRate
// (settings module). code is system-generated (settingsService.
// createCoupon / generateCouponCode), never staff-typed.
model Coupon {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  discountBp     Int // basis points off the pre-tax subtotal, e.g. 1500 = 15%; capped at 5000 (50%) app-side
  maxRedemptions Int? // null = unlimited (until expired); N = capped; 1 = single-use
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  redemptions CouponRedemption[]

  @@map("coupons")
}

// The "usage" record for a Coupon -- created when it's applied to an
// Invoice (counted at apply-time, not payment-time -- see DR-104), deleted
// outright when removed (releases the slot) or when its parent Coupon is
// (DR-144). One row per (coupon, invoice).
model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @db.Uuid
  invoiceId     String   @db.Uuid
  discountMinor Int // snapshot of the discount amount actually applied
  redeemedAt    DateTime @default(now())

  // DR-144 (explicit user request, reverses DR-104's original "never hard-
  // delete a Coupon, only deactivate it" choice): onDelete: Cascade means
  // deleting a Coupon now also deletes its redemption history -- a
  // deliberate, confirmed trade-off (loses the per-invoice usage audit
  // trail for that coupon; settingsService.deleteCoupon's own
  // settings.coupon_deleted audit entry is what's left as the record that
  // it existed and was removed).
  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([couponId, invoiceId])
  @@index([couponId])
  @@map("coupon_redemptions")
}

// A single payment attempt against an Invoice (deposit or balance leg). The
// DPO gateway is stubbed this increment: initiate() fabricates a PENDING
// record + fake redirect; a staff-only "resolve" route flips it to
// SUCCEEDED/FAILED, standing in for DPO's future webhook. See
// PaymentGateway (invoicing/gateway.ts) -- only the adapter changes when
// real DPO commercial terms land, no caller does.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceId      String        @db.Uuid
  kind           PaymentKind
  amountMinor    Int
  currency       Currency
  provider       String        @default("DPO")
  providerRef    String? // fake reference/redirect token from the stub gateway
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------- ratings (DR-037)
// Customer Ratings & Feedback -- closes the gap DR-029/030 deliberately left
// open ("no rating field -- deferred until a real reviews system exists").
// A client rates after their tour completes, using a single-use RatingCode
// (issued by staff once the booking's invoice is PAID) + their
// bookingReference as a two-factor, session-less lookup (same shape as
// Booking.confirmationCode + last name, DR-016).
enum RatingSubjectType {
  DRIVER
  GUIDE
}

// One per Booking (bookingId unique) -- no separate status column, state is
// derived from usedAt/expiresAt (see ratingsService.isRatingCodeUsable),
// same "lazy, derived state" precedent as Booking.holdExpiresAt.
model RatingCode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  bookingId      String    @unique @db.Uuid
  code           String    @unique
  issuedByUserId String    @db.Uuid
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  review       Review?

  @@index([organizationId])
  @@map("rating_codes")
}

// One per Booking -- a used, single-use RatingCode implies exactly one
// Review. overallRating is the mandatory "overall agency experience" score;
// per-driver/per-guide scores live in ReviewSubjectRating.
model Review {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  bookingId      String   @unique @db.Uuid
  ratingCodeId   String   @unique @db.Uuid
  touristUserId  String   @db.Uuid
  overallRating  Int
  overallComment String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ratingCode     RatingCode            @relation(fields: [ratingCodeId], references: [id], onDelete: Cascade)
  subjectRatings ReviewSubjectRating[]

  @@index([organizationId])
  @@index([bookingId])
  @@map("reviews")
}

// Zero-or-more per Review -- one row per rated driver/guide (a departure can
// have several vehicles/drivers, DR-018). guideUserId points at User
// directly, mirroring Assignment.guideUserId (not GuideProfile.id).
model ReviewSubjectRating {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  reviewId        String            @db.Uuid
  subjectType     RatingSubjectType
  driverProfileId String?           @db.Uuid
  guideUserId     String?           @db.Uuid
  rating          Int
  comment         String?           @db.VarChar(1000)
  createdAt       DateTime          @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review        Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  driverProfile DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  guide         User?          @relation(fields: [guideUserId], references: [id])

  @@index([organizationId])
  @@index([reviewId])
  @@index([driverProfileId])
  @@map("review_subject_ratings")
}

// ---------------------------------------------------------- finance (DR-039)
// Cost-plus pricing engine -- replaces TourPackage.priceMinor as a plain
// staff-typed number. The rate tables below are platform-wide config
// (no organizationId, no RLS), same precedent as TaxRate/CountryRegulation,
// effective-dated (validFrom/validTo) exactly like TaxRate -- "seasonal
// pricing" is expressed as overlapping date-ranged rows, no separate season
// concept needed. PackageCostBreakdown/PackageCostLineItem ARE org-scoped
// (they're real operational data, not shared config) and get standard RLS.
// DR-126 adds a seventh table, AdminCostRate, same shape/precedent as the
// original six.

// DR-147: PHOTOGRAPHER/VIDEOGRAPHER removed -- a photographer/videographer
// is priced as a guest-facing AddonService PHOTOGRAPHY/VIDEOGRAPHY purchase
// (AddonRate), not an operational Staff cost-plus rate.
enum StaffRateRole {
  DRIVER
  GUIDE
}

model StaffRate {
  id             String        @id @default(uuid()) @db.Uuid
  country        String // ISO-3166 alpha-2
  role           StaffRateRole
  dailyRateMinor Int
  currency       Currency
  validFrom      DateTime      @default(now())
  validTo        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([country, role, validFrom])
  @@map("staff_rates")
}

// roomCategory is freeform (e.g. "Standard", "Deluxe", "Suite") -- mirrors
// Vehicle.vehicleType's open-ended-string precedent rather than an enum,
// since categories vary too much across properties/countries.
model HotelRate {
  id               String    @id @default(uuid()) @db.Uuid
  country          String
  // DR-116: which real Hotel (itinerary module) this rate is priced for --
  // required going forward (CreateHotelRateInput), nullable here only so
  // pre-DR-116 rows stay valid. onDelete: SetNull rather than Cascade -- a
  // hotel being removed from the reference list shouldn't delete its
  // pricing history, just orphan the reference (same reasoning as
  // ItineraryDay.hotelId).
  hotelId          String?   @db.Uuid
  roomCategory     String
  nightlyRateMinor Int
  currency         Currency
  validFrom        DateTime  @default(now())
  validTo          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([country, validFrom])
  @@index([hotelId])
  @@map("hotel_rates")
}

// DR-131: restaurant counterpart to HotelRate, priced per (restaurant, day)
// rather than split into separate breakfast/lunch/dinner rates -- the Day
// Template only ever assigns one restaurant per day (ItineraryDay/
// PackageItineraryDay.restaurantId), so one flat daily rate per restaurant
// is the right granularity, resolved the same "effective by entity id +
// date" way HotelRate now is. restaurantId is required (unlike HotelRate.
// hotelId) -- no rows predate this table, so there's no legacy-nullable case
// to support.
model RestaurantRate {
  id             String    @id @default(uuid()) @db.Uuid
  country        String
  restaurantId   String    @db.Uuid
  dailyRateMinor Int
  currency       Currency
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([country, validFrom])
  @@index([restaurantId])
  @@map("restaurant_rates")
}

// All four figures are per-day estimates, summed then multiplied by a
// package's transportDays.
model TransportRate {
  id                        String    @id @default(uuid()) @db.Uuid
  country                   String
  fuelEstimateMinor         Int
  tollFeesMinor             Int
  parkingFeesMinor          Int
  vehicleOperatingCostMinor Int
  currency                  Currency
  validFrom                 DateTime  @default(now())
  validTo                   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([country, validFrom])
  @@map("transport_rates")
}

// Merges "Restaurant estimates" (breakfast/lunch/dinner) and "Drinks"
// (water/soft drinks/juice/local/alcoholic) into one table -- both are
// per-person/per-unit consumable rates, just different category values.
enum FoodBeverageCategory {
  BREAKFAST
  LUNCH
  DINNER
  WATER
  SOFT_DRINK
  JUICE
  LOCAL_BEVERAGE
  ALCOHOLIC
}

model FoodBeverageRate {
  id           String               @id @default(uuid()) @db.Uuid
  country      String
  category     FoodBeverageCategory
  perUnitMinor Int
  currency     Currency
  validFrom    DateTime             @default(now())
  validTo      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([country, category, validFrom])
  @@map("food_beverage_rates")
}

// Open-ended per the spec's "other attraction fees" -- name is freeform,
// same reasoning as HotelRate.roomCategory. DR-116: name is now a snapshot
// copied from the linked Activity at creation time (never re-synced on
// rename) rather than staff-typed -- activityId is the source of truth for
// which real Activity this prices, nullable only for pre-DR-116 rows.
model ActivityFee {
  id         String    @id @default(uuid()) @db.Uuid
  country    String
  activityId String?   @db.Uuid
  name       String
  feeMinor   Int
  currency   Currency
  validFrom  DateTime  @default(now())
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([country, validFrom])
  @@index([activityId])
  @@map("activity_fees")
}

// DR-154: ImmigrationCostRate removed entirely -- visa cost is priced as a
// guest-facing AddonService VISA_ASSISTANCE purchase (AddonRate), not a
// Staff cost-plus bucket line item, same fix DR-147 already applied to
// Photographer/Videographer. Keeping it would have double-counted a
// guest's visa cost once here and again in the AddonRate the guest is
// actually charged.
enum AdminCostBasis {
  PER_PERSON
  PER_GROUP
}

// DR-126: a flat per-day administrative overhead fee, auto-resolved by
// country + effective date at compute time exactly like StaffRate (no id
// staff-picks from a dropdown) -- there's only ever one active rate per
// country, not several distinct sub-entities the way HotelRate/ActivityFee
// have. Whether it's charged once for the whole group or multiplied per
// traveler is a per-breakdown choice (AdminCostBasis on PackageCostBreakdown/
// BookingCostBreakdown), not part of the rate itself.
model AdminCostRate {
  id             String    @id @default(uuid()) @db.Uuid
  country        String
  dailyRateMinor Int
  currency       Currency
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([country, validFrom])
  @@map("admin_cost_rates")
}

// DR-128: brings AddonService (catalog module) pricing under Operational
// Rates -- resolved by (country, code) + effective date, same auto-resolved
// "no id" precedent as StaffRate/AdminCostRate (AddonCode is a small fixed
// enum, not a list of distinct instances the way Hotel/Activity are, so no
// FK is needed the way HotelRate/ActivityFee have one). AddonService itself
// keeps code/name/description/active as catalog identity; its own
// priceMinor/currency are no longer read for pricing purposes (DR-128) --
// see src/lib/addon-rates.ts, which resolves this table directly with no
// AuthContext/permission gate, same precedent as src/lib/tax.ts, since
// guest checkout (an anonymous session, no staff permissions) must be able
// to read it too. If no rate is configured for a country+code, that add-on
// is simply not offered there -- never falls back to AddonService's own
// flat price.
model AddonRate {
  id         String    @id @default(uuid()) @db.Uuid
  country    String
  code       AddonCode
  priceMinor Int
  currency   Currency
  validFrom  DateTime  @default(now())
  validTo    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([country, code, validFrom])
  @@map("addon_rates")
}

// DR-222: a small staff-curated reference list of airports used to key
// FlightFareRate routes -- not an exhaustive world database, the same
// curation philosophy as itinerary's Hotel/Restaurant/Site reference
// entities, but platform-wide (no organizationId) like every other
// Operational Rate table, since flight fares aren't org-specific either.
model Airport {
  id        String   @id @default(uuid()) @db.Uuid
  iataCode  String   @unique @db.Char(3)
  name      String
  city      String
  country   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fareRatesAsOrigin      FlightFareRate[] @relation("FlightFareOrigin")
  fareRatesAsDestination FlightFareRate[] @relation("FlightFareDestination")

  @@map("airports")
}

// DR-222: the FLIGHT_TICKET add-on's price varies by route (origin/
// destination airport) x airline x class -- a genuinely multi-dimensional
// rate, so unlike AddonRate (a small fixed enum, "no id") this needs a real
// FK-able identity per row, the same "list of distinct instances" shape as
// HotelRate/ActivityFee. airline is free text (staff-entered per rate row,
// not a separate Airline reference table) -- the guest-facing airline
// choice is simply whatever distinct airline strings exist among active
// rates for the route picked. Effective-dated like every other Operational
// Rate; resolved by src/lib/flight-fare-rate.ts with no AuthContext gate,
// same guest-checkout-must-read-it-too precedent as AddonRate.
model FlightFareRate {
  id                   String      @id @default(uuid()) @db.Uuid
  originAirportId      String      @db.Uuid
  destinationAirportId String      @db.Uuid
  airline              String
  flightClass          FlightClass
  priceMinor           Int
  currency             Currency
  validFrom            DateTime    @default(now())
  validTo              DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  originAirport      Airport @relation("FlightFareOrigin", fields: [originAirportId], references: [id])
  destinationAirport Airport @relation("FlightFareDestination", fields: [destinationAirportId], references: [id])

  @@index([originAirportId, destinationAirportId, airline, flightClass, validFrom])
  @@map("flight_fare_rates")
}

// DR-222: the ESIM add-on's price varies by data-plan tier (e.g. 5/10/20GB),
// not just by country -- otherwise the same auto-resolved, no-id,
// effective-dated shape as AddonRate, just with dataAllowanceGb as a second
// key alongside country. Resolved by src/lib/esim-rate.ts, same
// no-AuthContext-gate precedent as AddonRate/FlightFareRate.
model EsimDataPlanRate {
  id              String    @id @default(uuid()) @db.Uuid
  country         String
  dataAllowanceGb Int
  priceMinor      Int
  currency        Currency
  validFrom       DateTime  @default(now())
  validTo         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([country, dataAllowanceGb, validFrom])
  @@map("esim_data_plan_rates")
}

// One per TourPackage. referenceGroupSize is the divisor for the per-seat
// price -- deliberately decoupled from any specific Departure.capacity,
// since a package can have several departures with different capacities
// but price stays package-level. Rate FKs are nullable (a package might
// have no accommodation, no visa requirement, etc.).
model PackageCostBreakdown {
  id                         String         @id @default(uuid()) @db.Uuid
  organizationId             String         @db.Uuid
  tourPackageId              String         @unique @db.Uuid
  currency                   Currency // must match TourPackage.currency -- no FX conversion anywhere in this app
  referenceGroupSize         Int
  nights                     Int
  driverDays                 Int
  guideDays                  Int
  // DR-147: photographerDays/videographerDays removed -- a photographer/
  // videographer is priced as a guest-facing AddonService PHOTOGRAPHY/
  // VIDEOGRAPHY purchase (added on top at booking time via AddonRate), not
  // a Staff cost-plus bucket line item.
  // DR-131: accommodation/restaurant/activities are no longer staff-picked
  // here at all (hotelRateId/roomsNeeded/breakfastCount/lunchCount/
  // dinnerCount removed) -- they're derived automatically from this
  // package's own Day Template (PackageItineraryDay.hotelId/restaurantId/
  // activityIds), resolved against HotelRate/RestaurantRate/ActivityFee by
  // entity id + effective date, then charged per-traveler
  // (referenceGroupSize). The three computed*Minor columns below are a
  // snapshot for display only -- computedBaseCostMinor is still the sum of
  // record.
  transportRateId            String?        @db.Uuid
  transportDays              Int            @default(0)
  // DR-154: requiresVisa/immigrationCostRateId removed -- see
  // ImmigrationCostRate's own removal note above.
  // DR-126: admin cost, resolved via AdminCostRate by country + effective
  // date (same "no stored rate id" precedent as driverDays/guideDays above,
  // not a staff-picked dropdown like transportRateId). basis decides
  // whether the resolved dailyRateMinor is multiplied by referenceGroupSize
  // (PER_PERSON) or charged once for the whole group (PER_GROUP, the
  // default -- an admin overhead fee is usually shared).
  adminDays                  Int            @default(0)
  adminCostBasis             AdminCostBasis @default(PER_GROUP)
  agencyMarginBp             Int // basis points, e.g. 2000 = 20%
  computedAccommodationMinor Int?
  computedRestaurantMinor    Int?
  computedActivitiesMinor    Int?
  // Added for the package summary PDF (staff download, package detail
  // page): Transport/Admin were already computed by computeCostBuckets at
  // save time but, unlike the three buckets above, never persisted
  // individually -- only folded into computedBaseCostMinor. Snapshot only,
  // same "never re-resolve live" precedent as every other computed*Minor
  // column here.
  computedTransportMinor     Int?
  computedAdminMinor         Int?
  computedBaseCostMinor      Int?
  computedSellingPriceMinor  Int?
  // DR-134: display/audit-trail snapshot of the tax + platform fee folded
  // into TourPackage.priceMinor (whole-group, like the computed*Minor
  // fields above) -- computedTotalMinor = computedSellingPriceMinor + tax +
  // platform fee. The two *RateBpSnapshot fields record whatever rate was
  // actually effective when this breakdown was last saved (never re-read
  // live afterward).
  computedTaxMinor           Int?
  computedPlatformFeeMinor   Int?
  computedTotalMinor         Int?
  taxRateBpSnapshot          Int?
  platformFeeRateBpSnapshot  Int?
  // Override + audit trail (spec: "Administrators may override calculated
  // prices when necessary while maintaining an audit trail"). The audit
  // trail itself lives in the append-only audit_logs table (via audit()),
  // not duplicated here -- these columns are just "is an override
  // currently in effect," not history.
  overridePriceMinor         Int?
  overrideReason             String?        @db.VarChar(500)
  overriddenByUserId         String?        @db.Uuid
  overriddenAt               DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourPackage  TourPackage           @relation(fields: [tourPackageId], references: [id], onDelete: Cascade)
  lineItems    PackageCostLineItem[]

  @@index([organizationId])
  @@map("package_cost_breakdowns")
}

// Zero-or-more per breakdown -- one row per selected drink (a beyond-base
// FoodBeverageRate category: WATER/SOFT_DRINK/JUICE/LOCAL_BEVERAGE/
// ALCOHOLIC), with a per-person quantity. DR-131 removed the activityFeeId
// variant this table used to also carry -- activities are no longer a
// staff-picked line item, they're derived automatically from the Day
// Template (see PackageCostBreakdown's own comment).
model PackageCostLineItem {
  id                     String @id @default(uuid()) @db.Uuid
  organizationId         String @db.Uuid
  packageCostBreakdownId String @db.Uuid
  foodBeverageRateId     String @db.Uuid
  quantityPerPerson      Int

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packageCostBreakdown PackageCostBreakdown @relation(fields: [packageCostBreakdownId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([packageCostBreakdownId])
  @@map("package_cost_line_items")
}

// DR-092: one per TAILOR_MADE Booking, computed by the same rate tables/
// math as PackageCostBreakdown -- deliberately a separate table, not a
// polymorphic/nullable-dual-FK subject on the package one, since
// PackageCostBreakdown.tourPackageId is an existing, working, unique
// non-nullable FK not worth destabilizing. No referenceGroupSize --
// Booking.seats plays that role internally (still genuinely "cost per this
// many people" for the restaurant/line-item math), but there's no
// per-seat division afterward: Booking.priceMinor is a whole-booking total
// (seats * unit price for a package hold), unlike TourPackage.priceMinor,
// which is per-seat. No caller-supplied currency either -- derived from
// whichever currency the resolved rates/add-ons are actually in (see
// financeService.saveBookingCostBreakdown).
model BookingCostBreakdown {
  id                         String         @id @default(uuid()) @db.Uuid
  organizationId             String         @db.Uuid
  bookingId                  String         @unique @db.Uuid
  currency                   Currency
  nights                     Int
  driverDays                 Int
  guideDays                  Int
  // DR-147: photographerDays/videographerDays removed -- see the same note
  // on PackageCostBreakdown above.
  // DR-131: same removal/replacement as PackageCostBreakdown above --
  // accommodation/restaurant/activities derive from the linked customized
  // package's Day Template (Booking.customizedPackageId), 0 if unset.
  transportRateId            String?        @db.Uuid
  transportDays              Int            @default(0)
  // DR-154: requiresVisa/immigrationCostRateId removed -- see
  // ImmigrationCostRate's own removal note above PackageCostBreakdown.
  adminDays                  Int            @default(0)
  adminCostBasis             AdminCostBasis @default(PER_GROUP)
  agencyMarginBp             Int
  computedAccommodationMinor Int?
  computedRestaurantMinor    Int?
  computedActivitiesMinor    Int?
  computedBaseCostMinor      Int?
  computedSellingPriceMinor  Int?
  // Snapshot of the booking's already-selected add-ons' total at save time
  // -- same "snapshot, don't live-join" convention as BookingAddon.priceMinor
  // and Booking.priceMinor itself. Goes stale if add-ons change after a
  // save, same as this row's rate-derived fields go stale until resaved --
  // a staff resave clears it, same as everywhere else in this feature
  // family; the staff UI shows the live add-ons total alongside this
  // snapshot so the gap is visible, not hidden.
  addonsTotalMinor           Int            @default(0)
  overridePriceMinor         Int?
  overrideReason             String?        @db.VarChar(500)
  overriddenByUserId         String?        @db.Uuid
  overriddenAt               DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineItems    BookingCostLineItem[]

  @@index([organizationId])
  @@map("booking_cost_breakdowns")
}

// Same shape/purpose as PackageCostLineItem (drinks only, DR-131), FK'd to
// BookingCostBreakdown.
model BookingCostLineItem {
  id                     String @id @default(uuid()) @db.Uuid
  organizationId         String @db.Uuid
  bookingCostBreakdownId String @db.Uuid
  foodBeverageRateId     String @db.Uuid
  quantityPerPerson      Int

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingCostBreakdown BookingCostBreakdown @relation(fields: [bookingCostBreakdownId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingCostBreakdownId])
  @@map("booking_cost_line_items")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid // matches User.id's native type -- required for the FK to work
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------- analytics (DR-155)
// One row per anonymous plan-my-trip wizard session, tracking only the
// highest step reached (0-8, see analytics/domain.ts's WIZARD_STEP_LABELS) --
// no field values, no better-auth User/Session row. sessionToken is an opaque
// id set in a cookie the moment the wizard loads (no account exists until the
// final submit); rows older than 30 days are purged by a daily QStash job
// (see api/jobs/purge-wizard-progress).
model WizardProgressEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sessionToken   String   @unique
  highestStep    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("wizard_progress_events")
}
