{
  "name": "polco-whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone always-on Baileys WhatsApp bridge for POLCO TOURS (DR-258). Deployed separately from the Vercel app -- see README.md.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "9.1.4",
    "baileys": "6.7.24",
    "pino": "9.14.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/qrcode": "1.5.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
