# --- Database (Neon) -------------------------------------------------------
# Pooled connection (PgBouncer, "-pooler" host) used at runtime on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/polco?sslmode=require"
# Direct connection (no pooler) used for migrations / RLS apply.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/polco?sslmode=require"

# --- Auth (Better Auth) ----------------------------------------------------
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Observability (Phase 0 optional) --------------------------------------
SENTRY_DSN=""

# --- Payments (stubbed, OI-01 open) -----------------------------------------
# DPO_COMPANY_TOKEN=""
# DPO_SERVICE_TYPE=""
# DPO_ENV="sandbox"

# --- Object storage (Vercel Blob, fra1 -- DR-010, wired up for real by DR-015) -
# Passport documents only; never sent to the client (see documents module).
BLOB_READ_WRITE_TOKEN=""
# Public images (About/FAQ + package photos, DR-071/114) -- a SEPARATE Blob
# store from the one above: Vercel Blob stores are public-or-private
# store-wide, not per-object, so the private documents store above can never
# serve these. DR-130 root-caused every public image upload silently failing
# since DR-071 to exactly this. Connected via Vercel's dashboard "Connect
# Project" flow, which namespaces a custom-named connection -- the real token
# lands under `<name>_READ_WRITE_TOKEN`, not the plain name itself.
PUBLIC_BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN=""

# --- Notifications (DR-013, DR-026) -----------------------------------------
# Every channel gracefully degrades to "unavailable" when its vars are unset.
# RESEND_API_KEY=""
# DR-205: mufasasafaris.com is now a verified sending domain in Resend
# (resolves OI-05) -- set this in every environment (local .env + Vercel
# Production/Preview) to actually deliver to real recipients; omitting it
# falls back to onboarding@resend.dev, which only delivers to the Resend
# account owner's own address.
# RESEND_FROM_EMAIL="Mufasa Safaris & Tours <info@mufasasafaris.com>"
# WhatsApp is Baileys (DR-258), not the Cloud API OI-06 originally planned --
# a self-hosted always-on bridge (see whatsapp-bridge/), not a Meta credential.
# Point this at that bridge's deployed URL; the secret must match the
# bridge's own WHATSAPP_BRIDGE_SECRET. Deliberately left unconfigured until
# the bridge is deployed and paired.
# WHATSAPP_BRIDGE_URL="https://your-bridge-host.example.com"
# WHATSAPP_BRIDGE_SECRET=""
# AFRICAS_TALKING_API_KEY=""
# AFRICAS_TALKING_USERNAME=""

# --- Maps (Google Maps, DR-077, OI-13 partially resolved) -------------------
# Browser key -- powers the interactive pickup-location picker on the
# departure and Starlink-kit staff pages (src/components/ui/MapLocationPicker.tsx).
# Public by design (NEXT_PUBLIC_-prefixed, inlined into the client bundle) --
# restrict it via HTTP-referrer restriction (Websites) in Cloud Console, API
# restriction to Maps JavaScript API only. Unset, the picker gracefully falls
# back to the plain latitude/longitude number inputs alone -- no script load
# is attempted.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key -- for backend-only calls (Static Maps API, Routes API,
# Geocoding API). Must NOT be NEXT_PUBLIC_-prefixed. A referrer-restricted
# key can't be reused here: server-to-server calls send no Referer header,
# so Google rejects them against a Websites-restricted key. This key has no
# application restriction, so it relies entirely on staying secret (never in
# client code) plus a tight API restriction limited to exactly the
# server-side Maps APIs in use.
# GOOGLE_MAPS_SERVER_API_KEY=""

# --- Rate limiting (Upstash Redis, DR-066) -----------------------------------
# Real Redis-backed rate limiting for auth sign-in/sign-up and the public
# guest lookups (find-booking, rating-code) -- see src/lib/rate-limit.ts.
# Unset (OI-10, no account provisioned yet), both gracefully degrade: auth
# falls back to better-auth's own in-memory limiter, the guest lookups fall
# back to the original audit-log-backed counter (DR-016).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Scheduled jobs (Upstash QStash, DR-067) ---------------------------------
# Real periodic booking-lifecycle sweep across every organization -- see
# src/app/api/jobs/sweep-bookings/route.ts + src/lib/qstash.ts. Unset
# (OI-11, no account provisioned yet), the route just always rejects (401)
# rather than running an unverified sweep; the pre-existing lazy
# "sweep on next read" behavior (DR-016/058) is unaffected either way.
# QSTASH_TOKEN=""                # only needed to run scripts/register-qstash-schedule.ts
# QSTASH_CURRENT_SIGNING_KEY=""
# QSTASH_NEXT_SIGNING_KEY=""
# --- Only needed by scripts/register-qstash-schedule.ts, not by the app itself:
# APP_URL=""                     # the deployed URL QStash should call, e.g. https://polco-tours.vercel.app
